            },
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] }
          }
        },
        {
          "name": "Verify Organization",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/organizations/{{orgId}}/verify",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"VERIFIED\",\n  \"notes\": \"All documents reviewed and verified\"\n}"
            }
          }
        },
        {
          "name": "Reject Organization",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/organizations/{{orgId}}/verify",
