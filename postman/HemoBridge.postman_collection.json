            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\",\n  \"rejectionReason\": \"Missing valid CAC registration certificate.\"\n}"
            }
          }
        },
        {
          "name": "Suspend Organization",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/organizations/{{orgId}}/verify",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUSPENDED\",\n  \"notes\": \"Suspended pending investigation of reported incident.\"\n}"
            }
          }
        },
        {
          "name": "Update User Status",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/users/{{donorId}}/status",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUSPENDED\",\n  \"reason\": \"Violation of platform terms of service.\"\n}"
