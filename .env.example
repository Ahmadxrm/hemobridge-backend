# ============================================================
# HemoBridge Backend — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the real .env file
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# ---- PostgreSQL Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hemobridge_dev
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE=10000

# ---- JWT ----
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_minimum_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# ---- OTP ----
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_MAX=5

# ---- Termii (SMS) ----
# https://termii.com
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=HemoBridge
TERMII_BASE_URL=https://api.ng.termii.com/api

# ---- WhatsApp (Meta Business API) ----
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BASE_URL=https://graph.facebook.com/v20.0

# ---- Email (SendGrid) ----
# https://sendgrid.com
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@hemobridge.com
EMAIL_FROM_NAME=HemoBridge

# ---- Voice (Africa's Talking) ----
# https://africastalking.com
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=your_africastalking_username
AT_BASE_URL=https://voice.africastalking.com

# ---- Payments (Paystack) ----
# https://paystack.com
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ---- Low Stock ----
DEFAULT_LOW_STOCK_THRESHOLD=5
LOW_STOCK_CHECK_INTERVAL_MINUTES=30

# ---- Password Reset ----
PASSWORD_RESET_EXPIRES_IN_MINUTES=60

# ---- Frontend URL (for email links) ----
FRONTEND_URL=http://localhost:5173

# ---- Logging ----
LOG_LEVEL=debug
